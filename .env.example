# Vercel → Project → Settings → Environment Variables
# Also used if you run `vercel dev` locally.

# Required for form lead emails (https://resend.com)
RESEND_API_KEY=re_xxxxxxxx

# "From" address — use the real info@ mailbox domain after verifying it in Resend.
# Example (replace with their actual domain):
RESEND_FROM=Ember Chimney <info@emberchimney.com>
#
# Steps:
# 1. Resend → Domains → Add domain (the part after @ in info@...)
# 2. Add the DNS records Resend shows (SPF/DKIM)
# 3. Wait until domain status is Verified
# 4. Set RESEND_FROM as above and redeploy

# GoHighLevel — Ember "Ember LP Leads — Speed to Lead" inbound webhook
# (Automation → Workflows → Inbound Webhook trigger → copy URL)
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/xxxxxxxx

# GoHighLevel — Elevation Prospecting "Ember Ads Leads — Elevation" inbound webhook
# Second POST. Do not paste this over GHL_WEBHOOK_URL.
GHL_ELEVATION_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/xxxxxxxx
