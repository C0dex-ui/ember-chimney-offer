{
  "cleanUrls": true,
  "trailingSlash": true,
  "headers": [
    {
      "source": "/offer/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    },
    {
      "source": "/nj/offer/(.*)",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "functions": {
    "api/lead.js": {
      "memory": 256,
      "maxDuration": 10
    }
  }
}
